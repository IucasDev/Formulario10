<tr><td>Linha Viva + Campo</td><td>linha_viva, manobra, big_jumper, bt_energizado, ...</td><td>13</td></tr>
<tr><td>Aterramento</td><td>modelo_aterramento, obs_aterramento</td><td>2</td></tr>
<tr><td>Risco + Periodo</td><td>risco_eminente, prazo_risco, periodo_execucao</td><td>3</td></tr>
<tr><td>Ambiental</td><td>amb_abertura_faixa, poda, corte, aut_prop, app, ...</td><td>12</td></tr>
<tr><td>Local Intervencao</td><td>intervencao_em</td><td>1</td></tr>
<tr><td>Logistica</td><td>distribuir_postes, acesso, sinal, porteira, ...</td><td>8</td></tr>
<tr><td>Checklist</td><td>abelha, rocha, gas, calcada, cercas, elos, ...</td><td>9</td></tr>
<tr><td>Projeto &amp; Diversos</td><td>substituir_trafo, barramento, glv, adequacao, ...</td><td>8</td></tr>
<tr><td>Executar Obra</td><td>trocar_medidores, medidor_ligado, num_clientes, ...</td><td>5</td></tr>
