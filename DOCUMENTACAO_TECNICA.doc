<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<style>
body{font-family:'Segoe UI',Arial,sans-serif;font-size:11pt;color:#1e293b;background:#fff;margin:40px 50px;line-height:1.5}
h1{font-size:22pt;color:#1e40af;border-bottom:3px solid #3b82f6;padding-bottom:8px;margin-top:30px}
h2{font-size:16pt;color:#1e40af;border-bottom:2px solid #93c5fd;padding-bottom:5px;margin-top:25px;background:#eff6ff;padding:8px 12px}
h3{font-size:13pt;color:#2563eb;margin-top:20px}
p{margin:6px 0}
.code{font-family:Consolas,Courier New,monospace;background:#f1f5f9;border:1px solid #e2e8f0;padding:10px 14px;font-size:9.5pt;white-space:pre-wrap;margin:10px 0}
.info{background:#eff6ff;border-left:4px solid #3b82f6;padding:10px 14px;margin:10px 0}
.warn{background:#fef3c7;border-left:4px solid #f59e0b;padding:10px 14px;margin:10px 0}
table{border-collapse:collapse;width:100%;margin:12px 0;font-size:10pt}
